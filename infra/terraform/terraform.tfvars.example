# =====================================================================
# imlate — terraform.tfvars 예시
#
#   cp terraform.tfvars.example terraform.tfvars   후 값을 채운다.
#   terraform.tfvars 는 .gitignore 대상이다. **절대 커밋하지 말 것.**
#
#   아래 <...> 는 전부 플레이스홀더다. 실제 키/비밀번호를 이 파일에 남기지 않는다.
# =====================================================================

# ---------------- 공통 ----------------
aws_region  = "ap-northeast-2"
project     = "imlate"
environment = "prod"
timezone    = "Asia/Seoul"

additional_tags = {
  Owner = "skala-imlate"
}

# =====================================================================
# 아키텍처 요약 (기본값 기준)
#
#   인터넷 → Route53 A 레코드(skala-imlate.com → EIP)
#          → EC2 퍼블릭 서브넷의 nginx 80/443 (Let's Encrypt TLS)
#               ├ / , /lookup      → /var/www/imlate 정적 서빙(SPA 폴백)
#               └ /api, /actuator  → 127.0.0.1:8080 Spring
#          ← 아웃바운드도 같은 EIP (알리고 화이트리스트 대상)
#     RDS / ElastiCache 는 프라이빗 서브넷.
#
#   ALB / NAT Gateway / WAF 는 200명 규모에 오버스펙이라 끈다.
#   필요해지면 아래 변수만 true 로 바꾸면 된다(모듈은 그대로 남아 있다).
# =====================================================================

# ---------------- 네트워크 ----------------
vpc_cidr = "10.20.0.0/16"

# 비우면 리전에서 사용 가능한 AZ 2개를 자동 선택한다.
# availability_zones = ["ap-northeast-2a", "ap-northeast-2c"]

# NAT 미사용(월 $35~40 절감). 앱이 퍼블릭 서브넷에 있어 IGW 로 직접 나간다.
enable_nat_gateway = false
single_nat_gateway = true # enable_nat_gateway = true 로 되돌릴 때만 의미 있음

# 운영자 사무실/VPN 대역만 열어 준다. 비우면 SSH 규칙을 아예 만들지 않는다.
# (권장: SSH 를 열지 않고 SSM Session Manager 로 접속)
ssh_allowed_cidrs = []
# ssh_allowed_cidrs = ["203.0.113.10/32"]

# 인터넷 → EC2 직접 인바운드(80/443). enable_alb = false 일 때만 적용된다.
# 교육생 누구나 휴대폰으로 접속해야 하므로 전체 개방이 맞다.
direct_ingress_cidrs = ["0.0.0.0/0"]

# enable_alb = true 로 되돌릴 때만 쓰인다.
alb_ingress_cidrs = ["0.0.0.0/0"]

# ---------------- 도메인 / DNS / TLS  ★ 고정 URL ----------------
# 도메인은 Route53 콘솔에서 직접 구매한다. 구매하면 퍼블릭 호스팅 영역이 자동 생성되므로
# Terraform 은 그 영역을 조회만 하고 A 레코드만 얹는다(영역을 새로 만들지 않는다).
domain_name = "" # 예: "skala-imlate.com"

# 같은 서버를 가리키게 할 추가 도메인(A 레코드 + 인증서 SAN 에 함께 들어간다).
domain_aliases = []
# domain_aliases = ["www.skala-imlate.com"]

# 비우면 domain_name 의 상위 2개 라벨로 추정한다.
route53_zone_name = ""

create_dns_record = true
dns_record_ttl    = 300

# Let's Encrypt HTTPS. domain_name 이 비어 있으면 아무 일도 하지 않는다.
# 발급은 EC2 안의 systemd 타이머가 best-effort 로 수행하며,
# 실패해도 배포는 성공하고 nginx 는 80 포트로 계속 서비스한다.
enable_tls        = true
tls_contact_email = "" # 예: "ops@example.com" — 인증서 만료 알림 수신 주소(권장)

# ---------------- ALB / WAF (기본 비활성) ----------------
# 인스턴스 1대 구성에서 ALB 는 오버스펙이다(월 $18 고정 + LCU).
# 다시 켜려면 enable_alb = true + public_app = false + enable_nat_gateway = true
# + create_dns_record = false(대신 alb_dns_name 으로 alias 레코드 생성) 조합을 쓴다.
enable_alb            = false
alb_target_port       = 8080 # 8080 = Spring 직결 / 80 = EC2 nginx 경유(프론트 정적 서빙)
# Redis 제외 헬스 그룹. ElastiCache 장애로 인스턴스가 통째로 빠지는 것을 막는다.
alb_health_check_path = "/actuator/health/alb"

# ACM 인증서를 발급했다면 ARN 을 넣는다. 넣으면 443 리스너가 생기고 80 은 리다이렉트된다.
# (enable_alb = false 인 기본 구성에서는 ACM 대신 Let's Encrypt 를 쓴다.)
acm_certificate_arn = ""
# acm_certificate_arn = "arn:aws:acm:ap-northeast-2:<ACCOUNT_ID>:certificate/<CERT_ID>"

# WAF 는 ALB 에만 붙일 수 있어 enable_alb = false 면 어차피 만들어지지 않는다.
enable_waf                   = false
waf_rate_limit_per_5min      = 2000 # IP 당 5분 2000요청 초과 시 차단
waf_managed_rules_count_only = false

# ---------------- EC2 ----------------
instance_type         = "t3.small"
instance_architecture = "x86_64" # t4g 계열을 쓰면 "arm64"
public_app            = true     # 퍼블릭 서브넷 배치(ALB/NAT 없이 단독 운영)
associate_elastic_ip  = true     # ★ 고정 IP. 재배포해도 주소가 바뀌지 않는다.
key_pair_name         = ""       # 예: "imlate-prod-key" (deploy.sh --mode ssh 를 쓰려면 필요)
root_volume_size      = 30
install_nginx            = true
install_cloudwatch_agent = true

# deploy.sh --mode ssm 을 쓸 때만 필요하다(버킷은 별도로 만들어 둔다).
# 지정하면 EC2 역할에 해당 버킷 읽기 권한이 붙는다.
artifact_bucket_name = "" # 예: "imlate-artifacts"

# ---------------- RDS ----------------
db_instance_class        = "db.t4g.micro"
db_engine_version        = "8.0"
db_name                  = "imlate"
db_username              = "imlate_admin"
db_allocated_storage     = 20
db_max_allocated_storage = 100
db_multi_az              = false
db_backup_retention_days = 7
db_deletion_protection   = true
db_skip_final_snapshot   = false

# 비워 두면(주석 유지) random_password 로 자동 생성되어 SSM SecureString 에 저장된다.
# db_password = "<DB_PASSWORD>"

# ---------------- ElastiCache ----------------
redis_node_type                  = "cache.t4g.micro"
redis_engine_version             = "7.1"
redis_num_cache_clusters         = 1
redis_multi_az_enabled           = false
redis_transit_encryption_enabled = true
redis_at_rest_encryption_enabled = true
redis_auth_enabled               = true
# redis_auth_token = "<REDIS_AUTH_TOKEN>"   # 비우면 자동 생성

# ---------------- SES (메일) ----------------
enable_ses = true

# 도메인이면 DKIM CNAME 3건을 DNS 에 등록해야 한다(outputs.ses_dkim_dns_records).
# 이메일 주소면 AWS 가 보낸 검증 메일을 클릭해야 한다.
ses_identity = "<DOMAIN_OR_EMAIL>" # 예: "imlate.example.com" 또는 "no-reply@example.com"

ses_from_address             = "" # 비우면 ses_identity 기준으로 자동 구성
ses_from_name                = "기숙사 야간복귀 시스템"
enable_ses_configuration_set = false

# ---------------- 애플리케이션 URL ----------------
# 보통 비워 둔다. domain_name 을 지정했으면 https://{domain_name} 이 자동으로 쓰인다.
# 그 다음 순서는 ALB URL → EIP → 127.0.0.1 이다.
app_base_url   = "" # 예: "https://skala-imlate.com"
allowed_origin = "" # 비우면 app_base_url 과 동일

# 비우면 자동 생성된다(terraform output -raw lookup_token_secret / admin_api_key 로 확인).
# lookup_token_secret = "<LOOKUP_TOKEN_SECRET>"
# admin_api_key       = "<ADMIN_API_KEY>"

# ---------------- 문자 (알리고) ----------------
aligo_api_key = "<ALIGO_API_KEY>"
aligo_user_id = "<ALIGO_USER_ID>"
aligo_sender  = "<ALIGO_SENDER_PHONE>" # 사전 등록된 발신번호. 예: "0212345678"

# ---------------- 사감 연락처 ----------------
supervisor1_name  = "<SUPERVISOR_1_NAME>"
supervisor1_phone = "<SUPERVISOR_1_PHONE>" # 예: "01012345678"
supervisor1_email = "<SUPERVISOR_1_EMAIL>"

supervisor2_name  = "<SUPERVISOR_2_NAME>"
supervisor2_phone = "<SUPERVISOR_2_PHONE>"
supervisor2_email = "<SUPERVISOR_2_EMAIL>"
