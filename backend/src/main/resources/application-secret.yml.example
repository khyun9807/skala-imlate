# =====================================================================
# 비밀 설정 템플릿 (R10)
#
# 사용법
#   1) 이 파일을 프로젝트 실행 디렉터리의 config/application-secret.yml 로 복사한다.
#        mkdir -p backend/config
#        cp backend/src/main/resources/application-secret.yml.example backend/config/application-secret.yml
#   2) 아래 값을 실제 값으로 채운다.
#   3) application.yml 의 `spring.config.import: optional:file:./config/application-secret.yml`
#      가 자동으로 읽어 들인다.
#
# 주의
#   - 실제 파일(config/application-secret.yml)은 .gitignore 로 커밋이 차단되어 있다.
#     절대 저장소에 커밋하지 말 것.
#   - AWS 운영 환경에서는 이 파일 대신 SSM Parameter Store(SecureString) 에 저장하고
#     EC2 user_data 가 환경변수로 주입하는 방식을 권장한다.
#   - 여기 적은 키 이름은 application.yml 의 프로퍼티 경로와 1:1로 대응한다.
# =====================================================================

spring:
  datasource:
    # RDS 엔드포인트 / 계정
    url: "jdbc:mysql://REPLACE-ME.rds.amazonaws.com:3306/imlate?useSSL=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8"
    username: "imlate"
    password: "REPLACE-ME-DB-PASSWORD"

  data:
    redis:
      # ElastiCache 엔드포인트 / AUTH 토큰
      host: "REPLACE-ME.cache.amazonaws.com"
      port: 6379
      password: "REPLACE-ME-REDIS-AUTH-TOKEN"
      ssl:
        enabled: true

imlate:
  lookup:
    # 사감에게 문자/메일로 전달할 조회 페이지 주소 (프론트 배포 주소)
    base-url: "https://imlate.example.com"
    # 조회 토큰 HMAC-SHA256 서명 키. 32바이트 이상 랜덤 문자열 권장.
    #   생성 예: openssl rand -base64 48
    token-secret: "REPLACE-ME-LOOKUP-TOKEN-SECRET"

  admin:
    # 관리 API(X-Admin-Key 헤더) 인증 키. 충분히 긴 랜덤 문자열 사용.
    api-key: "REPLACE-ME-ADMIN-API-KEY"

  web:
    allowed-origins:
      - "https://imlate.example.com"

  notification:
    # 사감 2명의 실제 연락처
    supervisors:
      - name: "홍사감"
        phone: "01012345678"
        email: "supervisor1@example.com"
      - name: "김사감"
        phone: "01087654321"
        email: "supervisor2@example.com"

  sms:
    provider: "aligo"
    aligo:
      # Aligo(https://smartsms.aligo.in) 발급 값
      api-key: "REPLACE-ME-ALIGO-API-KEY"
      user-id: "REPLACE-ME-ALIGO-USER-ID"
      # 사전 등록된 발신번호(하이픈 없이)
      sender: "0212345678"
      # true 면 실제 발송되지 않고 응답만 성공 처리된다. 운영 전환 시 false.
      test-mode: false

  email:
    provider: "ses"
    ses:
      region: "ap-northeast-2"
      # SES 에서 검증(verify)이 완료된 발신 주소 또는 도메인
      from: "no-reply@example.com"
      from-name: "기숙사 야간복귀 시스템"
      # 선택: 이벤트 추적용 configuration set 이름 (없으면 빈 문자열)
      configuration-set: ""
